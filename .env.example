# Create a bot using @BotFather in Telegram and paste the token locally.
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Your numeric Telegram user ID. Run /id in the bot, then restart after setting this.
ADMIN_IDS=
# Relative paths resolve against this project, not your terminal's current folder.
DATABASE_PATH=data/bot.sqlite3
SKIP_COOLDOWN_DAYS=7
